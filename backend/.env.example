# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster-name.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
